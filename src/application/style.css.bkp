@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@theme {
  --font-sans: "inter";
  --color-primary: #474647;
  --color-primary-dark: #474647;
  --color-primary-light: #EFE7DA;
  --color-cream: #EFE7DA;
  --color-bg: #FFFFFF;
  --color-bg-secondary: #F8F8F8;
  --color-bg-elevated: #FFFFFF;
  --color-border: #EFE7DA;
  --color-border-strong: #D4CFC7;
  --color-text: #474647;
  --color-text-secondary: #6B6B6B;
  --color-text-muted: #9A9A9A;
  --color-accent: #474647;
  --color-surface-hover: #F5F2EE;
  --color-code-bg: #EFE7DA;
  --color-bg-dark: #2A2A2A;
  --color-text-dark: #EFE7DA;
  --color-secondary-dark: #3A3A3A;
}

:root {
  --color-bg: #FFFFFF;
  --color-bg-secondary: #F8F8F8;
  --color-bg-elevated: #FFFFFF;
  --color-border: #EFE7DA;
  --color-border-strong: #D4CFC7;
  --color-text: #474647;
  --color-text-secondary: #6B6B6B;
  --color-text-muted: #9A9A9A;
  --color-accent: #474647;
  --color-surface-hover: #F5F2EE;
  --color-code-bg: #EFE7DA;
  --color-primary: #474647;
  --color-cream: #EFE7DA;
  --color-primary-light: #EFE7DA;
}

.dark {
  --color-bg: #2A2A2A;
  --color-bg-secondary: #3A3A3A;
  --color-bg-elevated: #3A3A3A;
  --color-border: #5A5A5A;
  --color-border-strong: #6A6A6A;
  --color-text: #EFE7DA;
  --color-text-secondary: #C4BFB5;
  --color-text-muted: #9A9A9A;
  --color-accent: #EFE7DA;
  --color-surface-hover: #3A3A3A;
  --color-code-bg: #3A3A3A;
  --color-primary: #EFE7DA;
  --color-cream: #EFE7DA;
  --color-primary-light: #3A3A3A;
}

.app-page {
  @apply min-h-screen flex flex-col;
  background-color: var(--color-bg);
}

.app-header {
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: var(--color-bg);
  border-bottom: 1px solid #E5E5E5;
}

.dark .app-header {
  background-color: var(--color-bg);
  border-bottom-color: #404040;
}

.app-brand {
  display: inline-flex;
  @apply flex items-center gap-2 text-sm font-semibold tracking-widest uppercase text-primary;
}

.brand-icon {
  @apply w-4 h-4 text-primary;
}

.app-header-mode {
  display: inline-flex;
  @apply text-xs font-medium tracking-wider uppercase text-primary;
}

.app-header-nav {
  @apply flex items-center gap-1.5 text-xs font-medium text-text-secondary hover:text-text transition-colors duration-200;
}

.icon-slate {
  @apply w-4 h-4 text-text-secondary;
}


.editor-container .cm-editor {
  @apply bg-transparent outline-none min-h-[300px];
}

.cmd-inline {
  position: relative;
  cursor: pointer;
}

.cmd-syntax {
  opacity: 0.4;
  color: #8A8A8A;
  font-size: 0.9em;
}

.cmd-content {
  opacity: 1;
  color: #474647;
}

.cmd-content--bold {
  font-weight: bold;
}

.cmd-content--italic {
  font-style: italic;
}

.cmd-inline--bold,
.cmd-inline--italic {
  opacity: 0.7;
  color: #555555;
}

.cmd-content.cmd-line--title {
  color: #474647;
}

.cmd-line--title[data-level="1"] {
  font-size: 2em;
  font-weight: bold;
  color: #474647;
  display: block;
  margin: 0.5em 0;
}

.cmd-line--title[data-level="2"] {
  font-size: 1.5em;
  font-weight: bold;
  color: #474647;
}

.cmd-line--title[data-level="3"] {
  font-size: 1.25em;
  font-weight: bold;
  color: #474647;
}



.cmd-url {
  opacity: 0.6;
  color: #6B8AB8;
}

.cmd-email {
  opacity: 0.6;
  color: #8B6B8B;
}

.cmd-inline .raw {
  display: none;
  font-family: monospace;
  background: #fef3c7;
  padding: 0 2px;
  border-radius: 2px;
}

.cmd-inline:hover .raw {
  display: inline;
}

.cmd-inline:hover .interpreted {
  display: none;
}

.cmd-url {
  color: #474647;
  text-decoration: underline;
  cursor: pointer;
}

.cmd-email {
  color: #474647;
  text-decoration: underline;
  cursor: pointer;
}

.cmd-line {
  position: relative;
  cursor: pointer;
}

.cmd-line .raw {
  display: none;
  font-family: monospace;
  background: #f0f0f0;
  padding: 2px 4px;
  border-radius: 3px;
}

.cmd-line:hover .raw {
  display: block;
}

.cmd-line:hover .interpreted {
  display: none;
}

.editor-container .cm-editor {
  background-color: var(--color-bg);
  color: var(--color-text);
  outline: none;
  min-height: 300px;
}

.editor-container .cm-scroller {
  font-family: inherit;
  line-height: 1.625;
}

.editor-container .cm-content {
  caret-color: auto;
}

.editor-container .cm-line {
  padding: 0 4px;
}

.editor-container .cm-gutters {
  background-color: var(--color-bg-secondary);
  border-right: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.editor-container .cm-activeLineGutter {
  background-color: #F5F2EE;
  color: #474647;
}

.editor-container .cm-content {
  caret-color: #474647;
}

.editor-container .cm-activeLine {
  background-color: rgba(71, 70, 71, 0.03);
}

.editor-container {
  background-color: var(--color-bg);
}

.editor-main {
  @apply flex-1 max-w-4xl w-full mx-auto px-6 pt-8 pb-24 flex flex-col;
  background-color: var(--color-bg);
}

.dark .editor-main {
  background-color: var(--color-bg);
}

.editor-meta {
  @apply mb-4 flex items-center justify-between text-xs font-medium tracking-wider uppercase;
}

.meta-filename {
  @apply text-text-muted;
}

.meta-wordcount {
  @apply text-text-muted font-mono;
}

.meta-counts {
  @apply flex items-center gap-2 text-xs font-medium text-text-muted;
}

.meta-divider {
  @apply text-text-muted;
}

.meta-charcount {
  @apply font-mono;
}

.editor-contenteditable {
  @apply text-base leading-relaxed text-text placeholder-text-muted focus:outline-none focus:ring-0 p-3 min-h-[300px];
  background-color: var(--color-bg);
  outline: none;
  white-space: pre-wrap;
  word-wrap: break-word;
  overflow-wrap: break-word;
  line-height: 1.625;
}

.editor-contenteditable:empty::before {
  content: attr(data-placeholder);
  color: #94a3b8;
  pointer-events: none;
}

.editor-container {
  @apply relative flex-1 flex flex-col;
}

.cmd {
  position: relative;
  cursor: pointer;
}

.cmd .interpreted {
  display: inline;
}

.cmd .raw {
  display: none;
}

.cmd:hover .interpreted {
  display: none;
}

.cmd:hover .raw {
  display: inline;
  background-color: #fef3c7;
  padding: 0 2px;
  border-radius: 2px;
}

.cmd-line {
  display: block;
}

.cmd-line .interpreted {
  display: block;
}

.cmd-line .raw {
  display: none;
  font-family: monospace;
  background: #fef3c7;
  padding: 2px 4px;
  border-radius: 3px;
}

.cmd-line:hover .interpreted {
  display: none;
}

.cmd-line:hover .raw {
  display: block;
}

.cmd-line.committed .raw {
  display: none;
}

.cmd-line.committed.editing .raw {
  display: block;
}

.cmd-line.committed.editing .interpreted {
  display: none;
}

.cmd-line.committed .interpreted {
  display: block;
}

.cmd-line.committed:hover .interpreted {
  display: block;
}

.cmd-line.committed:hover .raw {
  display: none;
}

.toolbar {
  @apply fixed bottom-0 left-0 right-0 border-t border-primary-light;
  background-color: var(--color-bg);
}

.toolbar-container {
  @apply max-w-3xl mx-auto px-4 h-14 flex items-center justify-between;
}

.toolbar-actions {
  @apply flex items-center gap-2;
}

.btn-utility {
  @apply inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-text-secondary rounded-lg hover:bg-surface-hover transition-colors duration-200 active:scale-95;
}

.dark .toolbar {
  background-color: var(--color-bg);
}

.modal-header {
  @apply px-6 h-16 border-b border-primary-light flex items-center justify-between bg-[#FFFFFF];
}

.modal-footer {
  @apply px-6 h-14 border-t border-primary-light flex items-center justify-between bg-[#FFFFFF];
}

.dark .modal-header,
.dark .modal-footer {
  background-color: #474647;
}

.modal-header {
  @apply px-6 h-16 border-b border-primary/10 flex items-center justify-between bg-cream;
}

.modal-title {
  @apply flex items-center space-x-2.5 font-semibold text-text;
}

.btn-close-modal {
  @apply p-1.5 rounded-lg hover:bg-primary/5 text-text-secondary transition-colors duration-200 active:scale-95;
}

.modal-content {
  background-color: #FFFFFF;
  @apply flex-1 overflow-y-auto px-8 py-6 text-text leading-relaxed whitespace-pre-line;
}

.dark .modal-content {
  background-color: #2A2A2A;
}

.modal-footer {
  @apply px-6 h-14 border-t border-primary/10 flex items-center justify-between bg-cream;
}

.btn-primary-modal {
  @apply px-4 py-1.5 bg-primary text-primary-light font-medium text-xs rounded-lg hover:bg-primary/90 transition-colors duration-200 active:scale-95;
}

.markdown-body h1 {
  @apply text-2xl font-bold text-text mb-4 pb-2 border-b border-primary/10;
}

.markdown-body h2 {
  @apply text-xl font-semibold text-text mt-6 mb-3;
}

.markdown-body p {
  @apply mb-4 text-base text-text-secondary;
}

.markdown-body ul {
  @apply list-disc list-inside mb-4 pl-2 space-y-1 text-text-secondary;
}

.markdown-body blockquote {
  @apply my-5 pl-4 border-l-4 border-primary italic text-text-muted bg-primary-light/50 py-2 rounded-r-lg;
}

.markdown-body code {
  @apply px-1.5 py-0.5 bg-primary/5 text-text text-sm rounded font-mono font-medium;
}

.readcard-page {
  @apply min-h-screen bg-[#FFFFFF] flex flex-col;
}

.readcard-content {
  @apply flex-1 max-w-2xl w-full mx-auto px-8 py-12;
}

.readcard-title {
  font-size: 1.875rem;
  font-weight: 700;
  color: #474647;
  margin-bottom: 1.5rem;
}

.readcard-body {
  font-size: 1rem;
  line-height: 1.625;
  color: #474647;
}

.readcard-body h1 { font-size: 1.5em; font-weight: bold; margin-bottom: 0.5em; }
.readcard-body p { margin-bottom: 1em; }
.readcard-body a { color: #3b82f6; text-decoration: underline; }

.dark .readcard-page { background-color: #474647; }
.dark .readcard-title { color: #EFE7DA; }
.dark .readcard-body { color: #EFE7DA; }
.dark .readcard-body h1 { color: #EFE7DA; }
.dark .readcard-body a { color: #93c5fd; }

.readcard-footer {
  padding: 2rem 2rem;
}

.readcard-divider {
  max-width: 42rem;
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  border-top: 1px solid rgba(71, 70, 71, 0.1);
  margin-bottom: 1rem;
}

.readcard-footer-link {
  display: block;
  max-width: 42rem;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
  font-size: 0.875rem;
  color: #9a9a9a;
  transition: color 0.2s ease-in-out;
}

.readcard-footer-link:hover { color: #474647; }

.dark .readcard-divider { border-color: rgba(239, 231, 218, 0.1); }
.dark .readcard-footer-link { color: #8a8a8a; }
.dark .readcard-footer-link:hover { color: #efe7da; }

.modal-overlay {
  display: none;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 50;
  align-items: center;
  justify-content: center;
}

.modal-overlay.is-active {
  display: flex;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.modal-card {
  background-color: #FFFFFF;
  @apply max-w-lg w-full rounded-xl shadow-2xl flex flex-col overflow-hidden;
}

.dark .modal-card {
  background-color: #2A2A2A;
}

.modal-card--sm {
  @apply max-w-md h-auto;
}

.key-input-field {
  @apply w-full px-3 py-2 text-sm text-text bg-primary-light border border-primary/10 rounded-lg shadow-sm placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors duration-200;
}

.ciphertext-textarea {
  @apply w-full h-36 px-3 py-2 text-xs text-text-secondary bg-cream border border-primary/10 rounded-lg shadow-sm font-mono resize-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors duration-200;
}

.input-error-msg {
  @apply mt-2 text-xs text-red-500 font-medium;
}

.btn-copied {
  @apply text-emerald-600;
}

.btn-copied .icon-slate {
  @apply text-emerald-500;
}

.reader-main {
  @apply flex-1 max-w-2xl w-full mx-auto px-4 py-10 flex flex-col gap-6;
}

.reader-header {
  @apply flex flex-col gap-1;
}

.reader-title {
  @apply text-xl font-bold text-text tracking-tight;
}

.reader-subtitle {
  @apply text-sm text-text-muted;
}

.history-list {
  @apply flex flex-col gap-3;
}

.history-item {
  @apply flex items-center gap-4 bg-primary-light border border-primary/10 rounded-xl px-4 py-3 shadow-sm hover:shadow-md transition-shadow duration-200;
}

.history-item-icon {
  @apply w-9 h-9 rounded-full bg-primary/5 flex items-center justify-center shrink-0;
}

.history-lock-icon {
  @apply w-4 h-4 text-primary;
}

.history-item-body {
  @apply flex-1 flex flex-col gap-0.5 min-w-0;
}

.history-item-id {
  @apply text-xs font-mono text-text-muted truncate;
}

.history-item-date {
  @apply text-xs text-text-muted;
}

.history-item-actions {
  @apply flex items-center gap-1 shrink-0;
}

.history-delete-btn {
  @apply p-1.5 rounded-lg hover:bg-red-50 text-text-muted hover:text-red-400 transition-colors duration-200 active:scale-95;
}

.history-delete-icon {
  @apply w-4 h-4;
}

.history-empty {
  @apply flex-1 flex flex-col items-center justify-center gap-3 py-20 text-center;
}

.history-empty-icon {
  @apply w-10 h-10 text-text-muted;
}

.history-empty-text {
  @apply text-sm font-medium text-text;
}

.history-empty-sub {
  @apply text-xs text-text-muted;
}

.dark .editor-container {
  background-color: var(--color-bg);
}


.dark .editor-container .cm-gutters {
  background-color: #474647;
  color: #9A9A9A;
  border-right: 1px solid #5A5A5A;
}

.dark .editor-container .cm-activeLineGutter {
  background-color: #3A3A3A;
  color: #EFE7DA;
}

.dark .editor-container .cm-content {
  caret-color: #EFE7DA;
}

.dark .editor-container .cm-activeLine {
  background-color: rgba(239, 231, 218, 0.05);
}

.light .editor-container {
  background-color: var(--color-bg);
}

.light .editor-container .cm-editor {
  background-color: #ffffff;
  color: #474647;
}

.light .editor-container .cm-gutters {
  background-color: #f5f2ee;
  color: #9a9a9a;
  border-right: 1px solid #efe7da;
}

.light .editor-container .cm-activeLineGutter {
  background-color: #efe7da;
  color: #474647;
}

.light .editor-container .cm-content {
  caret-color: #474647;
}

.light .editor-container .cm-activeLine {
  background-color: rgba(0, 0, 0, 0.03);
}
